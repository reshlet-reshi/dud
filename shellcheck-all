#!/bin/sh
set -eu

usage() {
    printf '%s\n' 'usage: ./shellcheck-all'
}

if [ "${1:-}" = "--help" ]; then
    usage
    exit 0
fi

if [ "$#" -ne 0 ]; then
    usage >&2
    exit 2
fi

shellcheck=\
'.bin/shellcheck-v0.11.0.linux.x86_64/'\
'shellcheck-v0.11.0/shellcheck'

script_list=
newline='
'

has_sh_shebang() {
    path="$1"
    prefix=$(dd if="$path" bs=18 count=1 2>/dev/null || true)

    case "$prefix" in
        '#!/bin/sh' | "#!/bin/sh$newline"* | \
        '#!/usr/bin/env sh' | "#!/usr/bin/env sh$newline"*) return 0 ;;
    esac

    return 1
}

is_shell_script() {
    path="$1"
    name=${path##*/}

    case "$name" in
        *.sh) return 0 ;;
        *.*) return 1 ;;
    esac

    has_sh_shebang "$path"
}

run_shellcheck() {
    path="$1"
    "$shellcheck" -x -s sh -- "$path"
}

trap '[ -z "$script_list" ] || rm -f "$script_list"' EXIT HUP INT TERM

script_list=$(mktemp "${TMPDIR:-/tmp}/dud-shellcheck-all.XXXXXX")

find . \
    \( \
        -path './.git' -o \
        -path './.bin' -o \
        -path './src/dud-tcc/.build' \
    \) -prune -o \
    -type f \
    -print >"$script_list"

status=0

while IFS= read -r path; do
    if is_shell_script "$path"; then
        run_shellcheck "$path" || status=1
    fi
done <"$script_list"

exit "$status"
