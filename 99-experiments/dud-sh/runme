#!/bin/sh
set -eu

usage() {
    printf '%s\n' 'usage: ./99-experiments/dud-sh/runme' >&2
}

if [ "$#" -ne 0 ]; then
    usage
    exit 2
fi

if [ ! -x .dud/musl-cc ]; then
    ./01-smoke-cc/runme
    ./02-musl-cc/runme
fi

if [ ! -x .dud/expect ]; then
    ./04-expect/runme
fi

mkdir -p .dud
.dud/musl-cc \
    -static \
    -std=c11 \
    -Wfatal-errors \
    99-experiments/dud-sh/main.c \
    99-experiments/dud-sh/action.c \
    99-experiments/dud-sh/clib/io.c \
    99-experiments/dud-sh/clib/str.c \
    99-experiments/dud-sh/clib/exit.c \
    99-experiments/dud-sh/fopen_argv.c \
    99-experiments/dud-sh/lex.c \
    -o .dud/dud-sh
./99-experiments/dud-sh/test/main
