#!/bin/sh
set -eu

test_tmp=$(mktemp -d "${TMPDIR:-/tmp}/dud-test-dud-sh.XXXXXX")

cleanup_test_tmp() {
    rm -rf "$test_tmp"
}

trap cleanup_test_tmp EXIT HUP INT TERM

.dud/expect error 2 '???' .dud/dud-sh
.dud/expect error 2 '???' .dud/dud-sh --to-lexer-symbols
.dud/expect error 2 '???' .dud/dud-sh -c ':'
.dud/expect error 1 '!!!' .dud/dud-sh --to-lexer-symbols "$test_tmp/no-such-file"

./99-experiments/dud-sh/test/to-lexer-symbols
