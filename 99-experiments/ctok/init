#!/bin/sh
set -eu

usage() {
    printf '%s\n' 'usage: ./99-experiments/ctok/init' >&2
}

if [ "$#" -ne 0 ]; then
    usage
    exit 2
fi

if [ ! -x .init/musl-cc ]; then
    ./01-smoke-cc/init
    ./02-musl-cc/init
fi

if [ ! -x .init/expect ]; then
    ./04-expect/init
fi

mkdir -p .init
.init/musl-cc -static -std=c11 -Wfatal-errors \
    99-experiments/ctok/main.c \
    -o .init/ctok
./99-experiments/ctok/test/main
