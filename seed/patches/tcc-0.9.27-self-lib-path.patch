+static void tcc_set_self_lib_path(TCCState *s, const char *argv0)
+{
+    char path[4096];
+    char *slash;
+    ssize_t len;
+
+    len = readlink("/proc/self/exe", path, sizeof(path) - 1);
+    if (len > 0) {
+        path[len] = 0;
+    } else {
+        if (!argv0 || !strchr(argv0, 47))
+            return;
+        snprintf(path, sizeof(path), "%s", argv0);
+    }
+
+    slash = strrchr(path, 47);
+    if (!slash)
+        return;
+    if (slash == path)
+        slash[1] = 0;
+    else
+        *slash = 0;
+    tcc_set_lib_path(s, path);
+}
