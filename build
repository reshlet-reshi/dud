#!/bin/sh
set -eu

usage() {
    printf '%s\n' 'usage: ./build [--clean]' >&2
}

if [ "$#" -eq 1 ] && [ "$1" = '--clean' ]; then
    rm -rf .bin
    exit 0
fi

# we expect no args
if [ "$#" -ne 0 ]; then
    usage
    exit 2
fi

# make scratch dir
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/dud-build.XXXXXX")
cleanup_tmp() { rm -rf "$tmp_dir"; }
trap cleanup_tmp EXIT HUP INT TERM

# ensure .bin dir
mkdir -p .bin

# unpack shellcheck
shellcheck_dir=.bin/shellcheck-v0.11.0.linux.x86_64
shellcheck=$shellcheck_dir/shellcheck-v0.11.0/shellcheck
if [ ! -x "$shellcheck" ]; then
    mkdir "$tmp_dir/shellcheck"
    tar -xJf vendor/shellcheck-v0.11.0.linux.x86_64.tar.xz \
        -C "$tmp_dir/shellcheck"
    rm -rf "$shellcheck_dir"
    mv "$tmp_dir/shellcheck" "$shellcheck_dir"
fi

# get list of all files in repo
file_list=$tmp_dir/files
find . \
    \( \
        -path './.git' -o \
        -path './.bin' \
    \) -prune -o \
    -type f \
    -print >"$file_list"

# run shellcheck on shell files
status=0
newline='
'
has_sh_shebang() {
    path=$1
    prefix=$(dd if="$path" bs=18 count=1 2>/dev/null || true)
    case "$prefix" in
        '#!/bin/sh' | "#!/bin/sh$newline"* | \
        '#!/usr/bin/env sh' | "#!/usr/bin/env sh$newline"*) return 0 ;;
    esac
    return 1
}
is_shell_script() {
    path=$1
    name=${path##*/}
    case "$name" in
        *.sh) return 0 ;;
        *.*) return 1 ;;
    esac
    has_sh_shebang "$path"
}
run_shellcheck() {
    path=$1
    "$shellcheck" -x -s sh -- "$path"
}
while IFS= read -r path; do
    if is_shell_script "$path"; then
        run_shellcheck "$path" || status=1
    fi
done <"$file_list"
if [ "$status" -ne 0 ]; then
    exit "$status"
fi

# helper to smoke test a c compiler
smoke_cc() {
    cc=$1
    return_0=$tmp_dir/return-0

    "$cc" -static src/return-0/main.c -o "$return_0"
    "$return_0"
}

# bootstrap musl-cc
musl_dir=.bin/x86_64-linux-musl-native
if [ ! -x "$musl_dir/bin/x86_64-linux-musl-gcc" ]; then
    mkdir "$tmp_dir/musl-exe"
    tar -xzf vendor/x86_64-linux-musl-native.tgz -C "$tmp_dir/musl-exe"
    rm -rf "$musl_dir"
    mv "$tmp_dir/musl-exe/x86_64-linux-musl-native" "$musl_dir"
fi
smoke_cc ./bin/musl-cc

# bootstrap dud-tcc
tcc_dir=.bin/bootstrap-tcc
tcc_stamp=src/dud-tcc/.stamp
tcc=$tcc_dir/tcc
if [ ! -d "$tcc_dir" ] ||
    [ ! -x "$tcc" ] ||
    [ "$tcc_stamp" -nt "$tcc_dir" ]
then
    ./src/dud-tcc/build
fi
smoke_cc ./bin/dud-tcc

# build
./src/build ./bin/musl-cc
