#!/bin/sh

set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
helpers_dir=$(dirname -- "$script_dir")/lib

if [ "$#" -ne 1 ]; then
  echo "usage: $0 PR_NUMBER" >&2
  exit 2
fi

pr_number=$1

case "$pr_number" in
  ''|*[!0-9]*)
    echo "usage: $0 PR_NUMBER" >&2
    exit 2
    ;;
esac

# shellcheck source=src/for-agents/lib/github-workflow.sh
. "$helpers_dir/github-workflow.sh"

cleanup_merged_pr "$pr_number"
