#!/bin/sh
set -eu

usage() {
    printf '%s\n' \
        'usage: ./src/expect/init CC' \
        'usage: ./src/expect/init --clean' >&2
}

if [ "$#" -eq 1 ] && [ "$1" = '--clean' ]; then
    rm -f .init/expect
    exit 0
fi

if [ "$#" -ne 1 ]; then
    usage
    exit 2
fi

cc=$1

mkdir -p .init
"$cc" src/expect/main.c -o .init/expect
./src/expect/test/main
