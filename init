#!/bin/sh
set -eu

usage() {
    printf '%s\n' 'usage: ./init [--clean]' >&2
}

if [ "$#" -eq 1 ] && [ "$1" = '--clean' ]; then
    rm -rf .init
    exit 0
fi

# we expect no args
if [ "$#" -ne 0 ]; then
    usage
    exit 2
fi

# make scratch dir
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/dud-init.XXXXXX")
cleanup_tmp() { rm -rf "$tmp_dir"; }
trap cleanup_tmp EXIT HUP INT TERM

# ensure .init dir
mkdir -p .init

./00-shellcheck/init
./01-smoke-cc/init
./02-musl-cc/init

# bootstrap dud-tcc
tcc_dir=.init/bootstrap-tcc
tcc_stamp=src/dud-tcc/.stamp
tcc=$tcc_dir/tcc
if [ ! -d "$tcc_dir" ] ||
    [ ! -x "$tcc" ] ||
    [ ! -x .init/dud-tcc ] ||
    [ "$tcc_stamp" -nt "$tcc_dir" ]
then
    ./src/dud-tcc/init
fi
./.init/smoke-cc ./.init/dud-tcc

# init
./src/init ./.init/musl-cc
