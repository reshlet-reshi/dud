#!/bin/sh
set -eu

if [ "$#" -ne 0 ]; then
    printf '%s\n' 'usage: ./check' >&2
    exit 2
fi

shellcheck_archive=vendor/shellcheck-v0.11.0.linux.x86_64.tar.xz
shellcheck_dir=.bin/shellcheck-v0.11.0.linux.x86_64
shellcheck=$shellcheck_dir/shellcheck-v0.11.0/shellcheck
shellcheck_tmp=
musl_cc_tmp=
check_tmp=

cleanup_tmp() {
    if [ -n "$shellcheck_tmp" ]; then
        rm -rf "$shellcheck_tmp"
    fi
    if [ -n "$musl_cc_tmp" ]; then
        rm -rf "$musl_cc_tmp"
    fi
    if [ -n "$check_tmp" ]; then
        rm -rf "$check_tmp"
    fi
}

trap cleanup_tmp EXIT HUP INT TERM

if [ ! -x "$shellcheck" ]; then
    mkdir -p .bin
    shellcheck_tmp=$(mktemp -d .bin/shellcheck.XXXXXX)
    tar -xJf "$shellcheck_archive" -C "$shellcheck_tmp"
    rm -rf "$shellcheck_dir"
    mv "$shellcheck_tmp" "$shellcheck_dir"
    shellcheck_tmp=
fi

"$shellcheck" -x -s sh -- ./shellcheck-all

# lint shell

./shellcheck-all

# bootstrap dud-tcc toolchain

musl_cc_dir=.bin/x86_64-linux-musl-native
musl_cc=$musl_cc_dir/bin/x86_64-linux-musl-gcc
if [ ! -x "$musl_cc" ]; then
    mkdir -p .bin
    musl_cc_tmp=$(mktemp -d .bin/x86_64-linux-musl-native.XXXXXX)
    tar -xzf vendor/x86_64-linux-musl-native.tgz -C "$musl_cc_tmp"
    rm -rf "$musl_cc_dir"
    mv "$musl_cc_tmp/x86_64-linux-musl-native" "$musl_cc_dir"
    rmdir "$musl_cc_tmp"
    musl_cc_tmp=
fi

tcc1=.bin/dud-tcc/tcc1
if [ ! -x "$tcc1" ]; then
    ./src/dud-tcc/build
fi

musl_cc() {
    "$musl_cc" \
        -std=c11 \
        -Wall \
        -Wextra \
        -Wpedantic \
        -Werror \
        -Wmissing-prototypes \
        -Wstrict-prototypes \
        -Wold-style-definition \
        -static \
        "$@"
}

# musl-cc smoke test

check_tmp=$(mktemp -d "${TMPDIR:-/tmp}/dud-check.XXXXXX")
return_0="$check_tmp/return-0"

musl_cc test/c/return-0.c -o "$return_0"
"$return_0"

# ensure build output dir

mkdir -p .bin

# build expect

musl_cc -Wfatal-errors src/expect/main.c -o .bin/expect

# build ctok

musl_cc -Wfatal-errors src/ctok/main.c -o .bin/ctok

# ctok tests

./test/ctok/main

# build dud-sh

musl_cc \
    src/dud-sh/main.c \
    src/dud-sh/action.c \
    src/clib/io.c \
    src/clib/str.c \
    src/clib/exit.c \
    src/dud-sh/fopen_argv.c \
    src/dud-sh/lex.c \
    -o .bin/dud-sh

# dud-sh smoke tests

.bin/expect error 2 '???' .bin/dud-sh
.bin/expect error 2 '???' .bin/dud-sh --to-lexer-symbols
.bin/expect error 2 '???' .bin/dud-sh -c ':'
.bin/expect error 1 '!!!' .bin/dud-sh --to-lexer-symbols "$check_tmp/no-such-file"

./test/dud-sh/to-lexer-symbols
