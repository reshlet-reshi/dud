#!/bin/sh
set -eu

if [ "$#" -ne 0 ]; then
    printf '%s\n' 'usage: ./check' >&2
    exit 2
fi

shellcheck_archive=vendor/shellcheck-v0.11.0.linux.x86_64.tar.xz
shellcheck_sha256=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
shellcheck_dir=.bin/shellcheck-v0.11.0.linux.x86_64
shellcheck=$shellcheck_dir/shellcheck-v0.11.0/shellcheck
shellcheck_tmp=
check_tmp=

cleanup_tmp() {
    if [ -n "$shellcheck_tmp" ]; then
        rm -rf "$shellcheck_tmp"
    fi
    if [ -n "$check_tmp" ]; then
        rm -rf "$check_tmp"
    fi
}

trap cleanup_tmp EXIT HUP INT TERM

printf '%s  %s\n' "$shellcheck_sha256" "$shellcheck_archive" | sha256sum -c -

if [ ! -x "$shellcheck" ]; then
    mkdir -p .bin
    shellcheck_tmp=$(mktemp -d .bin/shellcheck.XXXXXX)
    tar -xJf "$shellcheck_archive" -C "$shellcheck_tmp"
    rm -rf "$shellcheck_dir"
    mv "$shellcheck_tmp" "$shellcheck_dir"
    shellcheck_tmp=
fi

"$shellcheck" -x -s sh -- ./bin/shellcheck-all

# lint shell

./bin/shellcheck-all

# bootstrap seed toolchain

musl_cc=.bin/seed/x86_64-linux-musl-native/bin/x86_64-linux-musl-gcc
if [ ! -x "$musl_cc" ]; then
    ./seed/bootstrap
fi

# musl-cc smoke test

./test/test-musl-cc

# ensure build output dir

mkdir -p .bin

# build expect

./bin/musl-cc -Wfatal-errors src/expect.c -o .bin/expect

# build ctok

./bin/musl-cc -Wfatal-errors src/ctok.c -o .bin/ctok

# ctok tests

./test/test-ctok/main

# build dud-sh

./bin/musl-cc \
    src/dud-sh/main.c \
    src/dud-sh/action.c \
    src/clib/io.c \
    src/clib/str.c \
    src/clib/exit.c \
    src/dud-sh/fopen_argv.c \
    src/dud-sh/lex.c \
    -o .bin/dud-sh

# dud-sh smoke tests

check_tmp=$(mktemp -d "${TMPDIR:-/tmp}/dud-check.XXXXXX")

.bin/expect error 2 '???' .bin/dud-sh
.bin/expect error 2 '???' .bin/dud-sh --to-lexer-symbols
.bin/expect error 2 '???' .bin/dud-sh -c ':'
.bin/expect error 1 '!!!' .bin/dud-sh --to-lexer-symbols "$check_tmp/no-such-file"

./test/test-to-lexer-symbols
