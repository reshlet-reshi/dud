#!/bin/sh
set -eu

. ./lib/set-dud-tmp.sh
rm -rf "$dud_tmp"

self_check=false
allow_curl=false
for arg in "$@"; do
    case "$arg" in
        --self-check)
            self_check=true
            ;;
        --allow-curl)
            allow_curl=true
            ;;
    esac
done

if [ "$self_check" = true ]; then
    if [ "$allow_curl" = true ]; then
        ./self-check/0000-fetch-musl-cc --allow-curl
    else
        ./self-check/0000-fetch-musl-cc
    fi
fi
