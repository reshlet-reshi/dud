#!/bin/sh
set -eu

# we expect no args
if [ "$#" -ne 0 ]; then
    printf '%s\n' 'usage: ./check' >&2
    exit 2
fi

# make scratch dir
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/dud-check.XXXXXX")
cleanup_tmp() { rm -rf "$tmp_dir"; }
trap cleanup_tmp EXIT HUP INT TERM

# ensure .bin dir
mkdir -p .bin

# ./shellcheck-all
shellcheck_dir=.bin/shellcheck-v0.11.0.linux.x86_64
shellcheck=$shellcheck_dir/shellcheck-v0.11.0/shellcheck
if [ ! -x "$shellcheck" ]; then
    mkdir "$tmp_dir/shellcheck"
    tar -xJf vendor/shellcheck-v0.11.0.linux.x86_64.tar.xz \
        -C "$tmp_dir/shellcheck"
    rm -rf "$shellcheck_dir"
    mv "$tmp_dir/shellcheck" "$shellcheck_dir"
fi
"$shellcheck" -x -s sh -- ./shellcheck-all
./shellcheck-all

# smoke test a c compiler
smoke_cc() {
    cc=$1
    return_0=$tmp_dir/return-0

    "$cc" -static test/c/return-0.c -o "$return_0"
    "$return_0"
}

# musl-cc
musl_dir=.bin/x86_64-linux-musl-native
if [ ! -x "$musl_dir/bin/x86_64-linux-musl-gcc" ]; then
    mkdir "$tmp_dir/musl-exe"
    tar -xzf vendor/x86_64-linux-musl-native.tgz -C "$tmp_dir/musl-exe"
    rm -rf "$musl_dir"
    mv "$tmp_dir/musl-exe/x86_64-linux-musl-native" "$musl_dir"
fi
cat > "$tmp_dir/musl-cc" <<'EOF'
#!/bin/sh
set -eu
exec .bin/x86_64-linux-musl-native/bin/x86_64-linux-musl-gcc \
    -std=c11 \
    -Wall \
    -Wextra \
    -Wpedantic \
    -Werror \
    -Wfatal-errors \
    -Wmissing-prototypes \
    -Wstrict-prototypes \
    -Wold-style-definition \
    -static \
    "$@"
EOF
chmod +x "$tmp_dir/musl-cc"
mv "$tmp_dir/musl-cc" .bin/musl-cc
smoke_cc .bin/musl-cc

# dud-tcc
dud_tcc_dir=.bin/dud-tcc
dud_tcc_stamp=src/dud-tcc/.stamp
tcc1=$dud_tcc_dir/tcc1
if [ ! -d "$dud_tcc_dir" ] ||
    [ ! -x "$tcc1" ] ||
    [ "$dud_tcc_stamp" -nt "$dud_tcc_dir" ]
then
    ./src/dud-tcc/build
fi
smoke_cc "$tcc1"

# build + test

.bin/musl-cc src/expect/main.c -o .bin/expect
./test/expect/main

.bin/musl-cc src/ctok/main.c -o .bin/ctok
./test/ctok/main

.bin/musl-cc \
    src/dud-sh/main.c \
    src/dud-sh/action.c \
    src/clib/io.c \
    src/clib/str.c \
    src/clib/exit.c \
    src/dud-sh/fopen_argv.c \
    src/dud-sh/lex.c \
    -o .bin/dud-sh
./test/dud-sh/main
