#!/bin/sh
set -eu

# `sh -n` on scripts before we have a working shellcheck
#
# NOTE we purposly check a number of fixed scripts
# by hand first: those called downstream of ./bin/for-each-sh-script itself
#
# BUG maintainging this list by hand is gross, 
# but is the right thing to do, I think

sh -n ./bin/for-each-sh-script
sh -n ./bin/sh-n
sh -n ./bin/run-script-for-path-in-find
sh -n ./bin/run-script-foreach
sh -n ./bin/has-sh-shebang
./bin/for-each-sh-script sh ./bin/sh-n

# unpack the goodies

./bin/cache-vendored

# lint shell

./bin/shellcheck-all

# musl-cc smoke test

return_0_c='.cache/test/return-0.c'
return_0='.cache/test/return-0'

mkdir -p "$(dirname "$return_0")"
cat >"$return_0_c" <<'EOF'
int main(void) {
    return 0;
}
EOF

./bin/musl-cc "$return_0_c" -o "$return_0"
"$return_0"

# build dud-sh

./bin/musl-cc \
    src/main.c \
    src/action.c \
    src/dud/io.c \
    src/dud/str.c \
    src/dud/exit.c \
    src/fopen_argv.c \
    src/lex.c \
    -o .cache/dud-sh

# dud-sh smoke tests

# shellcheck disable=SC1091
. ./test/expect.sh

expect_error 2 '???' .cache/dud-sh
expect_error 2 '???' .cache/dud-sh --to-lexer-symbols
expect_error 2 '???' .cache/dud-sh -c ':'
expect_error 1 '!!!' .cache/dud-sh --to-lexer-symbols .cache/test/no-such-file

./test/test-to-lexer-symbols
