#!/bin/sh
set -eu

do_clear=1

if [ "${1:-}" = "--no-clear" ]; then
    do_clear=0
    shift
fi

if [ "$#" -ne 0 ]; then
    printf '%s\n' 'usage: ./check [--no-clear]' >&2
    exit 2
fi

# by default, clear the screen if writing to a tty

if [ "$do_clear" -ne 0 ] && [ -t 1 ]; then
    printf '\033[H\033[J'
fi

# `sh -n` on scripts before we have a working shellcheck
#
# NOTE we purposly check a number of fixed scripts
# by hand first: those called downstream of ./bin/for-each-sh-script itself
#
# BUG maintainging this list by hand is gross, 
# but is the right thing to do, I think

sh -n ./bin/for-each-sh-script
sh -n ./bin/has-sh-shebang
sh -n ./bin/run-script-for-path-in-find
sh -n ./bin/run-script-foreach
sh -n ./bin/sh-n
./bin/for-each-sh-script sh ./bin/sh-n

# unpack the goodies

./bin/cache-vendored

# lint shell

./bin/shellcheck-all

# musl-cc smoke test

./test/test-musl-cc

# ensure build output dir

mkdir -p .bin

# build expect

./bin/musl-cc -Wfatal-errors src/expect.c -o .bin/expect

# build ctok

./bin/musl-cc -Wfatal-errors src/ctok.c -o .bin/ctok

# ctok tests

./test/test-ctok/main

# build dud-sh

./bin/musl-cc \
    src/dud-sh/main.c \
    src/dud-sh/action.c \
    src/clib/io.c \
    src/clib/str.c \
    src/clib/exit.c \
    src/dud-sh/fopen_argv.c \
    src/dud-sh/lex.c \
    -o .bin/dud-sh

# dud-sh smoke tests

check_tmp=$(mktemp -d "${TMPDIR:-/tmp}/dud-check.XXXXXX")

cleanup_check_tmp() {
    rm -rf "$check_tmp"
}

trap cleanup_check_tmp EXIT HUP INT TERM

.bin/expect error 2 '???' .bin/dud-sh
.bin/expect error 2 '???' .bin/dud-sh --to-lexer-symbols
.bin/expect error 2 '???' .bin/dud-sh -c ':'
.bin/expect error 1 '!!!' .bin/dud-sh --to-lexer-symbols "$check_tmp/no-such-file"

./test/test-to-lexer-symbols
