#!/bin/sh
set -eu

usage() {
    printf '%s\n' 'usage: ./check <options>'
    printf '%s\n' ''
    printf '%s\n' 'options:'
    printf '%s\n' '  --self-check  run repository self-checks'
    printf '%s\n' '  --allow-curl  allow downloading tarballs with curl'
    printf '%s\n' '  --help        show this help and exit'
}

help=false
self_check=false
allow_curl=false
for arg in "$@"; do
    case "$arg" in
        --help)
            help=true
            ;;
        --self-check)
            self_check=true
            ;;
        --allow-curl)
            allow_curl=true
            ;;
        *)
            printf '%s\n' "unknown argument: $arg" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if [ "$help" = true ]; then
    usage
    exit 0
fi

tmp=${TMPDIR:-/tmp}/dud-tmp
rm -rf "$tmp"

if [ "$self_check" = true ]; then
    if [ "$allow_curl" = true ]; then
        ./self-check/0000-fetch-musl-cc --tmp "$tmp" --allow-curl
    else
        ./self-check/0000-fetch-musl-cc --tmp "$tmp"
    fi
fi
