#!/bin/sh
set -eu

# `sh -n` on scripts we run before we have a working shellcheck

sh -n check
sh -n bin/cache-vendored
sh -n bin/fetch
sh -n bin/fetch-source
sh -n bin/shellcheck-all

# unpack the goodies

./bin/cache-vendored

# lint shell

./bin/shellcheck-all

# musl-cc smoke test

musl_cc=\
'.cache/vendor/musl-cc/x86_64-linux-musl-native/'\
'x86_64-linux-musl-native/bin/x86_64-linux-musl-gcc'

return_0_c='.cache/test/return-0.c'
return_0='.cache/test/return-0'

mkdir -p "$(dirname "$return_0")"
cat >"$return_0_c" <<'EOF'
int main(void) {
    return 0;
}
EOF

"$musl_cc" -static "$return_0_c" -o "$return_0"
"$return_0"

# build dud-sh

"$musl_cc" \
    -static \
    src/main.c \
    src/action.c \
    src/fopen_argv.c \
    src/wc_c.c \
    src/exit.c \
    -o .cache/dud-sh

# dud-sh smoke tests

# shellcheck disable=SC1091
. ./lib/expect.sh

expect_error 2 '???' .cache/dud-sh
expect_error 2 '???' .cache/dud-sh --wc-c
expect_error 2 '???' .cache/dud-sh -c ':'
expect_error 1 '!!!' .cache/dud-sh --wc-c .cache/test/no-such-file

./test/test-wc-c
