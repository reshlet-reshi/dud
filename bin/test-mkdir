#!/bin/sh
set -eu

dir_path=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --dir-path)
            shift
            dir_path=${1:-}
            if [ "$dir_path" = "" ]; then
                break
            fi
            ;;
    esac
    shift
done

if [ "$dir_path" = "" ]; then
    printf '%s\n' '--dir-path is not set' >&2
    exit 2
fi

case "$dir_path" in
    /*) ;;
    *)
        printf '%s\n' "--dir-path is not absolute: $dir_path" >&2
        exit 2
        ;;
esac

if [ "$dir_path" = "/" ]; then
    printf '%s\n' '--dir-path must not be /' >&2
    exit 2
fi

if [ -e "$dir_path" ]; then
    if [ ! -d "$dir_path" ]; then
        printf '%s\n' "$dir_path exists but is not a directory" >&2
        exit 2
    fi
    if [ ! -r "$dir_path" ]; then
        printf '%s\n' "$dir_path exists but is not a readable" >&2
        exit 2
    fi
    if [ ! -w "$dir_path" ]; then
        printf '%s\n' "$dir_path exists but is not a writable" >&2
        exit 2
    fi
    exit 1
else
    exit 0
fi
