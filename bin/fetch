#!/bin/sh
set -eu

usage() {
    printf '%s\n' 'usage: ./bin/fetch <path_to_curl> <url> <out> [sha512]'
    printf '%s\n' ''
    printf '%s\n' './bin/fetch --test : run self test'
    printf '%s\n' './bin/fetch --help : show this help'
}

if [ "${1:-}" = "--test" ]; then
    ./bin/fetch.test
    exit $?
fi

if [ "${1:-}" = "--help" ]; then
    usage
    exit 0
fi

if [ "$#" -ne 3 ] && [ "$#" -ne 4 ]; then
    usage >&2
    exit 2
fi

path_to_curl=$1
url=$2
out=$3
sha512=${4:-}

if [ ! -e "$out" ]; then
    mkdir -p "$(dirname "$out")"
    "$path_to_curl" -fL "$url" -o "$out"
fi

if [ -n "$sha512" ]; then
    printf '%s  %s\n' "$sha512" "$out" | sha512sum -c -
fi
