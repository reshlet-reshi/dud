#!/bin/sh
set -eu

usage() {
    printf '%s\n' 'usage: ./bin/fetch <path_to_curl> <url> <out> [sha256]'
    printf '%s\n' ''
    printf '%s\n' './bin/fetch --test : run self test'
    printf '%s\n' './bin/fetch --help : show this help'
}

if [ "${1:-}" = "--test" ]; then
    sh -n test/test-fetch
    ./test/test-fetch
    exit $?
fi

if [ "${1:-}" = "--help" ]; then
    usage
    exit 0
fi

if [ "$#" -ne 3 ] && [ "$#" -ne 4 ]; then
    usage >&2
    exit 2
fi

path_to_curl=$1
url=$2
out=$3
sha256=${4:-}

if [ ! -e "$out" ]; then
    mkdir -p "$(dirname "$out")"
    "$path_to_curl" -fL "$url" -o "$out"

    if [ -n "$sha256" ]; then
        printf '%s  %s\n' "$sha256" "$out" | sha256sum -c -
    fi
fi
