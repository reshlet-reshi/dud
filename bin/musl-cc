#!/bin/sh
set -eu

repo_dir=$(
    CDPATH=
    cd "$(dirname "$0")/.."
    pwd
)

exec "$repo_dir/.bin/x86_64-linux-musl-native/bin/x86_64-linux-musl-gcc" \
    -std=c11 \
    -Wall \
    -Wextra \
    -Wpedantic \
    -Werror \
    -Wfatal-errors \
    -Wmissing-prototypes \
    -Wstrict-prototypes \
    -Wold-style-definition \
    -static \
    "$@"
