#!/bin/sh
set -eu

. ./lib/source-fetch.sh

usage() {
    printf '%s\n' 'usage: ./bin/fetch-source <source.fetch>'
}

if [ "$#" -ne 1 ]; then
    usage >&2
    exit 2
fi

source_fetch=$1

read_source_fetch "$source_fetch"

./bin/fetch curl "$source_fetch_url" "$source_fetch_out" "$source_fetch_sha256"
