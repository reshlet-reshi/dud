#!/bin/sh
set -eu

usage() {
    printf '%s\n' 'usage: ./bin/fetch-source <source.fetch>'
}

if [ "$#" -ne 1 ]; then
    usage >&2
    exit 2
fi

source_fetch=$1

if [ ! -f "$source_fetch" ]; then
    printf '%s\n' "source.fetch is not a regular file: $source_fetch" >&2
    exit 2
fi

if [ ! -r "$source_fetch" ]; then
    printf '%s\n' "source.fetch is not readable: $source_fetch" >&2
    exit 2
fi

# shellcheck disable=SC2046
set -- $(sed -n '1,$p' "$source_fetch")

if [ "$#" -ne 3 ]; then
    printf '%s\n' "source.fetch must contain exactly three fields: $source_fetch" >&2
    exit 2
fi

url=$1
out=$2
sha256=$3

./bin/fetch curl "$url" "$out" "$sha256"
