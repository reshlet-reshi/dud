#!/bin/sh
set -eu

tmp=$(mktemp -d "/tmp/dud-test-fetch.XXXXXX")
_cleanup_tmp() {
    rm -rf "$tmp"
}
trap _cleanup_tmp EXIT HUP INT TERM

mock_curl="$tmp/mock-curl"
mock_curl_calls="$mock_curl.calls"
cat >"$mock_curl" <<'EOF'
#!/bin/sh
set -eu
printf 'curl\n' >>"$0.calls"
while [ "$#" -gt 0 ]; do
    case "$1" in
        -o)
            shift
            : >"$1"
            ;;
    esac
    shift
done
EOF
chmod 755 "$mock_curl"

fetch_url='https://www.rfc-editor.org/rfc/rfc20.txt'
fetch_out="$tmp/rfc20.txt"
expected_sha512=\
'4c79bbd370f91098ebce376b9c44b84d'\
'9a2a0d7e11ae7db87bd08026a7abe097'\
'e890caed1c11a71498041bfd0cbdffb1'\
'afd1a038e763d738f9a8904edcfb563f'

sh -n bin/fetch
./bin/fetch "$mock_curl" "$fetch_url" "$fetch_out"
test "$(wc -l <"$mock_curl_calls")" -eq 1
test -e "$fetch_out"

./bin/fetch "$mock_curl" "$fetch_url" "$fetch_out"
test "$(wc -l <"$mock_curl_calls")" -eq 1

rm -f "$fetch_out"

./bin/fetch 'curl' "$fetch_url" "$fetch_out" "$expected_sha512"
