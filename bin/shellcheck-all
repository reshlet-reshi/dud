#!/bin/sh
set -eu

usage() {
    printf '%s\n' 'usage: ./bin/shellcheck-all'
}

if [ "${1:-}" = "--help" ]; then
    usage
    exit 0
fi

if [ "$#" -ne 0 ]; then
    usage >&2
    exit 2
fi

./bin/cache-vendored

shellcheck='.cache/vendor/shellcheck/shellcheck-v0.11.0.linux.x86_64/shellcheck-v0.11.0/shellcheck'

# shellcheck disable=SC2016
./bin/find-run ./bin/shellcheck-runner "$shellcheck" \
    \( -path './.git' -o -path './.cache' \) -prune -o \
    -type f \
    \( \
        -name '*.sh' \
        -o \
        -exec sh -c '
            first_line=
            IFS= read -r first_line <"$1" || true

            case "$first_line" in
                "#!/bin/sh" | "#!/usr/bin/env sh") exit 0 ;;
            esac

            exit 1
        ' sh {} \; \
    \)
