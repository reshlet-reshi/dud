#!/bin/sh
set -eu

usage() {
    printf '%s\n' 'usage: ./bin/shellcheck-all'
}

if [ "${1:-}" = "--help" ]; then
    usage
    exit 0
fi

if [ "$#" -ne 0 ]; then
    usage >&2
    exit 2
fi

./bin/cache-vendored

shellcheck=\
'.cache/vendor/shellcheck/shellcheck-v0.11.0.linux.x86_64/'\
'shellcheck-v0.11.0/shellcheck'

./bin/find-run ./bin/shellcheck-runner "$shellcheck" \
    \( -path './.git' -o -path './.cache' \) -prune -o \
    -type f \
    \( \
        -name '*.sh' \
        -o \
        -exec ./bin/has-sh-shebang {} \; \
    \)
