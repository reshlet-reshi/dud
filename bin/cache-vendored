#!/bin/sh
set -eu

. ./lib/source-fetch.sh

usage() {
    printf '%s\n' 'usage: ./bin/cache-vendored'
}

if [ "${1:-}" = "--help" ]; then
    usage
    exit 0
fi

if [ "$#" -ne 0 ]; then
    usage >&2
    exit 2
fi

vendor_tmp=
_cleanup_vendor_tmp() {
    if [ -n "$vendor_tmp" ]; then
        rm -rf "$vendor_tmp"
    fi
}
trap _cleanup_vendor_tmp EXIT HUP INT TERM

vendored_path_for_artifact() {
    artifact=$1

    case "$artifact" in
        vendor/*) ;;
        *)
            printf '%s\n' "artifact path must start with vendor/: $artifact" >&2
            return 2
            ;;
    esac

    vendor_artifact=${artifact#vendor/}

    case "$artifact" in
        *.tar.xz) printf '.vendor/%s\n' "${vendor_artifact%.tar.xz}" ;;
        *.tar.gz) printf '.vendor/%s\n' "${vendor_artifact%.tar.gz}" ;;
        *.tgz) printf '.vendor/%s\n' "${vendor_artifact%.tgz}" ;;
        *.tar.bz2) printf '.vendor/%s\n' "${vendor_artifact%.tar.bz2}" ;;
        *)
            printf '%s\n' "unsupported archive suffix: $artifact" >&2
            return 2
            ;;
    esac
}

extract_artifact() {
    artifact=$1
    destination=$2

    case "$artifact" in
        *.tar.xz) tar -xJf "$artifact" -C "$destination" ;;
        *.tar.gz) tar -xzf "$artifact" -C "$destination" ;;
        *.tgz) tar -xzf "$artifact" -C "$destination" ;;
        *.tar.bz2) tar -xjf "$artifact" -C "$destination" ;;
        *)
            printf '%s\n' "unsupported archive suffix: $artifact" >&2
            return 2
            ;;
    esac
}

cache_source_fetch() {
    source_fetch=$1

    read_source_fetch "$source_fetch"

    vendor_dir=$(vendored_path_for_artifact "$source_fetch_out")

    ./bin/fetch-source "$source_fetch"

    if [ -d "$vendor_dir" ]; then
        return 0
    fi

    if [ -e "$vendor_dir" ]; then
        printf '%s\n' "vendor destination exists but is not a directory: $vendor_dir" >&2
        return 1
    fi

    vendor_parent=$(dirname "$vendor_dir")
    mkdir -p "$vendor_parent"

    vendor_tmp=$(mktemp -d "$vendor_parent/.vendor-vendored.XXXXXX")
    extract_artifact "$source_fetch_out" "$vendor_tmp"

    if [ -e "$vendor_dir" ]; then
        printf '%s\n' "vendor destination appeared during extraction: $vendor_dir" >&2
        return 1
    fi

    mv "$vendor_tmp" "$vendor_dir"
    vendor_tmp=
}

if [ ! -d vendor ]; then
    exit 0
fi

source_fetches=$(find vendor -type f -name source.fetch | sort)

for source_fetch in $source_fetches; do
    cache_source_fetch "$source_fetch"
done
