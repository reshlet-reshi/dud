#!/bin/sh
set -eu

usage() {
    printf '%s' 'usage: ./self-check/0000-fetch-musl-cc'
    printf '%s\n' ' --tmp <path> [--allow-curl]'
}

allow_curl=false
tmp=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --allow-curl)
            allow_curl=true
            ;;
        --tmp)
            shift
            tmp=${1:-}
            if [ "$tmp" = "" ]; then
                usage >&2
                exit 2
            fi
            ;;
        --help)
            usage
            exit 0
            ;;
        *)
            printf '%s\n' "unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

if [ "$tmp" = "" ]; then
    usage >&2
    exit 2
fi

if [ "${tmp:-}" = "" ]; then
    printf '%s\n' '--tmp is not set' >&2
    exit 1
fi

case "$tmp" in
    /*) ;;
    *)
        printf '%s\n' "--tmp is not absolute: $tmp" >&2
        exit 1
        ;;
esac

if [ "$tmp" = "/" ]; then
    printf '%s\n' '--tmp must not be /' >&2
    exit 1
fi

if [ -e "$tmp" ]; then
    if [ ! -d "$tmp" ]; then
        printf '%s\n' "--tmp exists but is not a directory: $tmp" >&2
        exit 1
    fi
    if [ ! -r "$tmp" ]; then
        printf '%s\n' "--tmp exists but is not readable: $tmp" >&2
        exit 1
    fi
    if [ ! -w "$tmp" ]; then
        printf '%s\n' "--tmp exists but is not writable: $tmp" >&2
        exit 1
    fi
else
    mkdir -p "$tmp"
    _created_tmp=$tmp
    _cleanup_tmp() {
        rm -rf "$_created_tmp"
    }
    trap _cleanup_tmp EXIT HUP INT TERM
fi

mock_curl="$tmp/mock-curl"
mock_curl_calls="$mock_curl.calls"
: >"$mock_curl_calls"

{
    printf '%s\n' '#!/bin/sh'
    printf '%s\n' 'set -eu'
    printf '%s\n' 'exec ./bin/mock-curl "$0.calls" "$@"'
} >"$mock_curl"
chmod 755 "$mock_curl"

musl_cc_tarball="$tmp/x86_64-linux-musl-cross.tgz"
musl_cc_url=\
'https://more.musl.cc/11.2.1/x86_64-linux-musl/'\
'x86_64-linux-musl-cross.tgz'

sh -n bin/fetch
./bin/fetch "$mock_curl" "$musl_cc_url" "$musl_cc_tarball"
test "$(wc -l <"$mock_curl_calls")" -eq 1
test -e "$musl_cc_tarball"

./bin/fetch "$mock_curl" "$musl_cc_url" "$musl_cc_tarball"
test "$(wc -l <"$mock_curl_calls")" -eq 1

rm -f "$musl_cc_tarball"

if [ "$allow_curl" = true ]; then
    ./bin/fetch 'curl' "$musl_cc_url" "$musl_cc_tarball"
    musl_cc_sha512='checksums/musl-cc-11.2.1-x86_64-linux-musl-cross.tgz.sha512'
    ./bin/check-sha512 "$musl_cc_sha512" "$musl_cc_tarball"
    tar -tzf "$musl_cc_tarball" >/dev/null
fi
