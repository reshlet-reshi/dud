#!/bin/sh
set -eu

usage() {
    printf '%s' 'usage: ./self-check/0000-fetch-musl-cc'
    printf '%s\n' ' --tmp <path> [--allow-curl]'
}

allow_curl=false
tmp=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --allow-curl)
            allow_curl=true
            ;;
        --tmp)
            shift
            tmp=${1:-}
            if [ "$tmp" = "" ]; then
                usage >&2
                exit 2
            fi
            ;;
        --help)
            usage
            exit 0
            ;;
        *)
            printf '%s\n' "unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

if [ "$tmp" = "" ]; then
    usage >&2
    exit 2
fi

dud_tmp=$tmp

if [ "${dud_tmp:-}" = "" ]; then
    printf '%s\n' '--tmp is not set' >&2
    exit 1
fi

case "$dud_tmp" in
    /*) ;;
    *)
        printf '%s\n' "--tmp is not absolute: $dud_tmp" >&2
        exit 1
        ;;
esac

if [ "$dud_tmp" = "/" ]; then
    printf '%s\n' '--tmp must not be /' >&2
    exit 1
fi

if [ -e "$dud_tmp" ]; then
    if [ ! -d "$dud_tmp" ]; then
        printf '%s\n' "--tmp exists but is not a directory: $dud_tmp" >&2
        exit 1
    fi
    if [ ! -r "$dud_tmp" ]; then
        printf '%s\n' "--tmp exists but is not readable: $dud_tmp" >&2
        exit 1
    fi
    if [ ! -w "$dud_tmp" ]; then
        printf '%s\n' "--tmp exists but is not writable: $dud_tmp" >&2
        exit 1
    fi
else
    mkdir -p "$dud_tmp"
    _dud_tmp_created_path=$dud_tmp
    _cleanup_dud_tmp() {
        rm -rf "$_dud_tmp_created_path"
    }
    trap _cleanup_dud_tmp EXIT HUP INT TERM
fi

MUSL_CC_TARBALL="$dud_tmp/x86_64-linux-musl-cross.tgz"
export MUSL_CC_TARBALL

mock_curl=./bin/mock-curl

mock_curl_calls="$dud_tmp/mock-curl-calls"
export mock_curl_calls
: >"$mock_curl_calls"

sh -n steps/0000-fetch-musl-cc
./steps/0000-fetch-musl-cc "$mock_curl"
test "$(wc -l <"$mock_curl_calls")" -eq 1
test -e "$MUSL_CC_TARBALL"

./steps/0000-fetch-musl-cc "$mock_curl"
test "$(wc -l <"$mock_curl_calls")" -eq 1

unset mock_curl_calls
rm -f "$MUSL_CC_TARBALL"

if [ "$allow_curl" = true ]; then
    ./steps/0000-fetch-musl-cc 'curl'
    musl_cc_sha512='checksums/musl-cc-11.2.1-x86_64-linux-musl-cross.tgz.sha512'
    ./bin/check-sha512 "$musl_cc_sha512" "$MUSL_CC_TARBALL"
    tar -tzf "$MUSL_CC_TARBALL" >/dev/null
fi
